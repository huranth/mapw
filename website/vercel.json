{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/catalog", "destination": "/" },
    { "source": "/chips", "destination": "/" },
    { "source": "/how-it-works", "destination": "/" },
    { "source": "/under-the-hood", "destination": "/" },
    { "source": "/handbook", "destination": "/handbook.html" },
    { "source": "/docs", "destination": "/handbook.html" },
    { "source": "/field-notes", "destination": "/handbook.html" },
    { "source": "/download", "destination": "/api/download" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "statusCode": 308 },
    { "source": "/handbook.html", "destination": "/handbook", "statusCode": 308 }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://pdynfowdtiulrllqetbl.supabase.co; connect-src 'self' https://pdynfowdtiulrllqetbl.supabase.co https://github.com https://release-assets.githubusercontent.com https://github-releases.githubusercontent.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
